# ═══════════════════════════════════════════════════════════════
# KimiBlog 生产环境变量模板
# 用法: cp .env.example .env 然后填写真实值
# 此文件用于 docker compose 部署（服务器端）
# ═══════════════════════════════════════════════════════════════

# ── 必填 ──
# JWT 签名密钥 + OAuth client secret，建议生成 ≥32 字符随机串
APP_SECRET=

# 数据库连接（db 为 compose 服务名，容器内访问）
DATABASE_URL=mysql://kimiblog:kimiblog_pass@db:3306/kimi_blog

# ── Kimi OAuth ──
APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=

# 首个匹配此 union_id 的用户自动成为管理员
OWNER_UNION_ID=

# ── 管理员（首次启动自动创建默认账号）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── CORS（生产域名，逗号分隔，如 https://blog.example.com）──
CORS_ORIGINS=

# ── 前端构建参数（docker build 时使用，与 APP_ID/KIMI_AUTH_URL 一致）──
VITE_KIMI_AUTH_URL=
VITE_APP_ID=

# ── MySQL 容器 ──
MYSQL_ROOT_PASSWORD=kimiblog_root
MYSQL_DATABASE=kimi_blog
MYSQL_USER=kimiblog
MYSQL_PASSWORD=kimiblog_pass

# ── MinIO 对象存储（容器内通过服务名 minio 访问）──
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blog-uploads
MINIO_SECURE=false
# 公网访问 MinIO 的地址（图片 URL 前缀），如 http://服务器IP:9005
MINIO_PUBLIC_URL=
